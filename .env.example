# IA editorial (servidor, NUNCA frontend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_WEB_SEARCH=true

# Login del panel
ADMIN_PASSWORD=
JWT_SECRET=
TOKEN_TTL_HOURS=168

# Frontend Lovable permitido. Tras publicar Lovable añade su dominio aquí.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
PUBLIC_BASE_URL=

# Radar
SCAN_INTERVAL_MINUTES=60
AUTO_PIPELINE=false
# Evita importar hemeroteca antigua desde feeds con cientos de elementos.
MAX_CANDIDATE_AGE_DAYS=3
# Solo si activas AUTO_PIPELINE; el panel permite decidir noticia por noticia.
AUTO_DRAFTS_PER_SCAN=4
# Las piezas con 42-69 puntos se preparan como fichas para revisión.
MIN_AUTO_SCORE=42
QUICK_SCORE_MAX=69

# Publicación final (configurar cuando sepamos el backend real de infolinense.com)
PUBLISH_MODE=none
LOVABLE_WEBHOOK_URL=
LOVABLE_WEBHOOK_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ARTICLES_TABLE=articles

# En Railway conviene montar un volumen en /data
DATA_DIR=/data
DB_PATH=/data/infolinense.db
UPLOAD_DIR=/data/uploads
RENDER_DIR=/data/renders
# Las plantillas pueden quedar en la imagen Docker; si quieres subir nuevas y persistirlas, usa /data/templates
TEMPLATE_DIR=/data/templates
